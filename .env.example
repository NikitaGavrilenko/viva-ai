# Local Ollama mode is the default and does not require an API key.
PROMETHEUS_API_KEY=
PROMETHEUS_BASE_URL=http://localhost:11434/v1
PROMETHEUS_MODEL=qwen3:14b

# To use an OpenAI-compatible cloud API, replace the three values above:
# PROMETHEUS_API_KEY=replace-me
# PROMETHEUS_BASE_URL=https://api.openai.com/v1
# PROMETHEUS_MODEL=gpt-4.1-mini
